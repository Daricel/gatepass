{
  "name": "gatepass",
  "private": true,
  "version": "1.0.0",
  "description": "Event ticketing with signed QR tickets and live check-in",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspaces"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "author": "Daria Berciu",
  "license": "MIT"
}
